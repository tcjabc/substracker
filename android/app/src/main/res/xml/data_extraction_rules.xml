<?xml version="1.0" encoding="utf-8"?>
<!-- Backup and device-transfer rules for Android 12 and later (android:dataExtractionRules).
     Same as backup_rules.xml: everything as before except the secure-storage file that holds the
     Keystore-encrypted household key, for both cloud backups and phone-to-phone transfers. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="WSSecureStorageSharedPreferences.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="WSSecureStorageSharedPreferences.xml" />
    </device-transfer>
</data-extraction-rules>
