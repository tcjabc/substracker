{
  "name": "peek-budget",
  "version": "1.24.0",
  "private": true,
  "description": "Native (Capacitor) wrapper for the Peek Budget PWA. The web app itself needs no build step.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.node.test.js relay/test/*.test.js",
    "serve": "node scripts/serve.mjs",
    "copy:web": "node scripts/copy-web.mjs",
    "sync:web": "node scripts/copy-web.mjs && cap sync",
    "assets": "capacitor-assets generate --android --iconBackgroundColor #4f46e5 --iconBackgroundColorDark #4f46e5 --splashBackgroundColor #f6f6f9 --splashBackgroundColorDark #111216"
  },
  "dependencies": {
    "@aparajita/capacitor-secure-storage": "8.0.1",
    "@capacitor-mlkit/barcode-scanning": "8.2.2",
    "@capacitor/android": "8.6.2",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.6.2",
    "@capacitor/filesystem": "8.1.5",
    "@capacitor/share": "8.0.3",
    "@capacitor/status-bar": "8.0.4"
  },
  "devDependencies": {
    "@capacitor/assets": "4.0.0",
    "@capacitor/cli": "8.6.2"
  }
}
